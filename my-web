server {
    listen 80;
    server_name _;

    root /var/www/my-web/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Cấu hình trang lỗi 404 tùy chỉnh
    error_page 404 /404.html;

    # Khóa truy cập trực tiếp từ bên ngoài bằng chỉ thị internal
    location = /404.html {
        root /var/www/my-web/html;
        internal;
    }
}
